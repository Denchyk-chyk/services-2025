@model Dictionary<Fruit, int>

@{
    Layout = "_Layout";
}

<div class="container my-4">
    <section>
        <div class="d-flex flex-column align-items-center">
            <div class="thin-section w-100" style="max-width: 600px;">

                <div class="mt-4 d-flex align-items-center">
                    <h1 class="mb-4 me-auto">Корзина</h1>
                    <form method="post" asp-controller="Cart" asp-action="Clear" style="margin-top:-1rem">
                        <button type="submit" class="btn btn-danger">Очистити</button>
                    </form>
                </div>
                @foreach (var item in Model)
                {
                    <div class="bg-white shadow-sm p-3 rounded-3 mb-3 d-flex align-items-center" style="height:6rem">
                        <img class="d-inline-block" src="@item.Key.ImageUrl" alt="Зображення" style="width:4rem"/>
                        <h5 class="d-inline-block ms-3 mb-0 flex-grow-1">@item.Key.Name</h5>
                        <span class="text-secondary me-3">@item.Key.Price</span>

                        <form method="post" asp-controller="Cart" asp-action="Remove" class="m-0 p-0">
                            <input type="hidden" name="fruit" value="@item.Key.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Видалити</button>
                        </form>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <strong>Загальна сума:</strong>
                    <span class="fs-5 fw-bold">
                        @Model.Sum(i => i.Key.Price * i.Value)
                    </span>
                </div>

            </div>
        </div>
    </section>
</div>
