<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lab6</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lab6.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark fs-5 pt-2 pb-2">
            <div class="container">
                <!-- Логотип -->
                <a class="navbar-brand pe-5 fs-3 fw-bold" asp-area="" asp-controller="Fruits" asp-action="Index">
                    ФРУКТИ
                </a>

                <!-- Кнопка для розгортання на малих екранах -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Контент меню -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <!-- Кошик + Користувач -->
                    <ul class="ms-auto navbar-nav d-flex align-items-center">
                        <!-- Кошик -->
                        <li class="nav-item">
                            <a class="cart-icon nav-link position-relative" asp-controller="Cart" asp-action="Index">
                                <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor"
                                     class="bi bi-cart-fill" viewBox="0 -3 23 23">
                                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5
                                     8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5
                                     0 0 1-.5-.5M5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4
                                     2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2
                                     1 1 0 0 1 0-2" />
                                </svg>
                                <!-- Лічильник (у майбутньому реалізується через JS/Blazor/Partial) -->
                                <div id="cart-count-area" class="d-none counter rounded-pill bg-success position-absolute ">
                                    <p id="cart-count">0</p>
                                </div>
                            </a>
                        </li>

                        <!-- Меню користувача -->
                        <li class="nav-item">
                            @await Component.InvokeAsync("UserStatus")
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
