@model IEnumerable<Lab6.Models.Fruit>

@{
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <section>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var fruit in Model)
            {
                <div class="col">
                    <div class="card product-card text-dark h-100 shadow"
                         onclick="location.href='@Url.Action("Details", "Fruits", new { id = fruit.Id })'">
                        <img src="@fruit.ImageUrl" class="card-img-top" alt="@fruit.Name" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mt-auto">@fruit.Name</h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>
